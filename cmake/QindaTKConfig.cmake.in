@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 COMPONENTS Core Gui Qml Quick Svg Network)
# AGENT-CONTRACT (D-354): libvterm is a public link dependency of qindatk only
# when it was built in; an Android (or libvterm-less) package has none.
if(@QINDATK_ENABLE_LIBVTERM@)
    find_dependency(PkgConfig)
    pkg_check_modules(VTERM REQUIRED IMPORTED_TARGET vterm>=0.3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/QindaTKTargets.cmake")

# The QML module directory (contains qmldir, qmltypes and the plugin).
# Informational (plain set: a DESTDIR-staged install must still configure).
set(QindaTK_QML_DIR "@PACKAGE_QINDATK_QML_INSTALL_DIR@")
# The directory that CONTAINS the QindaTK module: what an application adds to
# its QML import path. Android consumers append it to the app target's
# QT_QML_IMPORT_PATH so androiddeployqt bundles the plugin (docs/android.md).
cmake_path(GET QindaTK_QML_DIR PARENT_PATH QindaTK_QML_IMPORT_PATH)

check_required_components(QindaTK)
