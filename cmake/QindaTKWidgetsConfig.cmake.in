@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(QindaTK CONFIG)
find_dependency(Qt6 COMPONENTS Widgets)
set(_qindatk_widgets_print "@QINDATK_WIDGETS_PRINT@")
if(_qindatk_widgets_print)
    find_dependency(Qt6 COMPONENTS PrintSupport)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/QindaTKWidgetsTargets.cmake")
check_required_components(QindaTKWidgets)
