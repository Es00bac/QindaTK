{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer (Debug, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "QINDATK_BUILD_EXAMPLES": "ON",
        "QINDATK_BUILD_TOOLS": "ON",
        "BUILD_TESTING": "ON",
        "QT_QML_GENERATE_QMLLS_INI": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QINDATK_BUILD_EXAMPLES": "OFF",
        "QINDATK_BUILD_TOOLS": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (Release, Qt for Android, library + QML module only)",
      "description": "docs/android.md. Needs Qt for Android 6.11 (Qt 6.8+) at /opt/qt6-android; override with -DCMAKE_TOOLCHAIN_FILE=... for another prefix.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "/opt/qt6-android/6.11.1/android_arm64_v8a/lib/cmake/Qt6/qt.toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/android-arm64/stage",
        "QINDATK_BUILD_TOOLS": "OFF",
        "QINDATK_BUILD_EXAMPLES": "ON",
        "BUILD_TESTING": "OFF",
        "QINDATK_ENABLE_POPPLER_QT6": "OFF",
        "QINDATK_ENABLE_ALSA": "OFF",
        "QINDATK_ENABLE_FFMPEG": "OFF",
        "QINDATK_ENABLE_QUICK3D": "OFF",
        "QINDATK_ENABLE_SHADER_TOOLS": "OFF",
        "QINDATK_ENABLE_DBUS": "OFF",
        "QINDATK_ENABLE_WIDGETS": "OFF",
        "QINDATK_ENABLE_NATIVE_PRINT": "OFF",
        "QINDATK_ENABLE_SQLITE": "OFF",
        "QINDATK_ENABLE_LCMS2": "OFF",
        "QINDATK_ENABLE_LIBVTERM": "OFF",
        "QINDATK_ENABLE_PLUGIN_HOST": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    }
  ]
}
